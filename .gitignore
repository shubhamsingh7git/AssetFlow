# ─── AssetFlow ERP Root GitIgnore ──────────────────────────────────────────

# Dependency Directories
node_modules/
**/node_modules/
.pnpm-store/

# Production Build Outputs
dist/
**/dist/
build/
**/build/
dist-ssr/
out/

# Environment Variables & Secrets (NEVER push credentials to Git)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!**/.env.example

# File Uploads & Local Media Storage
uploads/
**/uploads/
storage/
temp/
**/temp/
.tempmediaStorage/

# Log Files & Debuggers
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Database Files & Local SQLite Instances
*.db
*.sqlite
*.sqlite-journal
prisma/dev.db

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/

# Cache Directories
.cache/
.turbo/
.eslintcache
