# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/assetflow?schema=public

# ─── Cryptographically Secure JWT Secrets ──────────────────────────────────
# Must be 64+ characters long cryptographically random string (e.g. generated via crypto.randomBytes(48).toString('hex'))
JWT_SECRET=your_production_secure_64_character_jwt_secret_key_here
JWT_REFRESH_SECRET=your_production_secure_64_character_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# ─── Cloudinary (optional — file uploads) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Google OAuth (optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# ─── Resend Email Configuration ─────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=AssetFlow <onboarding@resend.dev>
APP_URL=http://localhost:5173
